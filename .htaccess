# Redirect www to non-www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.xeniumdesigns\.com$ [NC]
RewriteRule ^(.*)$ https://xeniumdesigns.com/$1 [L,R=301]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent directory listing
Options -Indexes
